# HOGANA Environment Configuration Example
# Copy this file to web/.env.local to configure external service integrations.

# Optional: Webhook URL to receive incoming transit agency pilot enquiries (Slack, Teams, CRM webhook, etc.)
# If left empty, pilot enquiries are securely recorded in the local demonstration store.
PILOT_ENQUIRY_WEBHOOK_URL=

# Optional: Port override for local development
PORT=3000
