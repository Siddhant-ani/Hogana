# HOGANA Environment Configuration Example
# Copy this file to web/.env.local or set in your deployment environment variables (e.g. Vercel dashboard).

# ==============================================================================
# 1. HOGANA Authentication Configuration (Server-Managed Sessions)
# ==============================================================================
# Secret key used to sign and verify HMAC-SHA256 HTTP-only session cookies.
# Minimum 32 characters recommended in production.
AUTH_SECRET=hogana-mobility-intelligence-secure-session-secret-2025

# Authenticated operator credentials.
# Passwords are NEVER stored in plaintext. They are hashed using scrypt (N=16384, r=8, p=1).
AUTH_USER_EMAIL=operator@hogana.transit
AUTH_USER_NAME=HOGANA Operations Dispatcher
AUTH_USER_ROLE=Lead Operations Dispatcher
# Salt (hex string, 16 bytes minimum):
AUTH_USER_SALT=3508c99d32951e4c750b10fad454553e
# Scrypt hash of password (e.g., for "HoganaOps@2025!"):
AUTH_USER_PASSWORD_HASH=6161bf7444c6915e9affeeeb6a5e04e81d6dbb72d0dca48efbf0793531da7c63da6662da2acb5e1ff1601f36c948a474096665c30cfe82e1440fd07f3d8bf8a9

# ==============================================================================
# 2. Supabase Database, Storage & Authentication (Free Tier Compatible)
# ==============================================================================
# Base REST API and Project URL
SUPABASE_URL=https://kseowooraqmdrteehtnt.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://kseowooraqmdrteehtnt.supabase.co

# Client-safe Publishable / Anon Key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_5S_fdbX-qbJKsKwzLrjPRA_GQ9gCKB8
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5S_fdbX-qbJKsKwzLrjPRA_GQ9gCKB8

# Server-only Secret / Service-Role Key (Never exposed to client)
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_supabase_secret_key_here

# JWKS URL for JWT verification
SUPABASE_JWKS_URL=https://kseowooraqmdrteehtnt.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Connection Strings (Transaction Pooler & Direct)
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL=postgresql://postgres.kseowooraqmdrteehtnt:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.kseowooraqmdrteehtnt:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Repository Source Toggle: 'local' (uses data/demo/ canonical files) or 'supabase' (uses PostgreSQL)
DATASET_SOURCE=local

# ==============================================================================
# 3. Pilot Enquiry Integration
# ==============================================================================
# Production Pilot Enquiry Destination:
# Webhook URL to receive incoming transit agency pilot enquiries (e.g., Zapier, Slack, Teams, CRM webhook, etc.)
# REQUIRED in production mode (NODE_ENV=production). If not configured in production, the API returns HTTP 503.
PILOT_ENQUIRY_WEBHOOK_URL=

# Local Demonstration Mode Override:
# Set to 'true' if running a production preview locally and wanting to log submissions to data/research/pilot_enquiries.json
ALLOW_LOCAL_DEMO_ENQUIRIES=false

# ==============================================================================
# 4. Optional Settings
# ==============================================================================
PORT=3000
